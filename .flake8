[flake8]
# Black-compatible configuration
max-line-length = 128
extend-ignore = E203, E501, W503, W504
max-complexity = 10

# Exclude common non-source directories
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info,
    .tox,
    .pytest_cache,
    .mypy_cache

# Per-file ignores for specific cases
per-file-ignores =
    __init__.py:F401,F403
    tests/*:E501

# Statistics and reporting
statistics = True
count = True
show-source = True
