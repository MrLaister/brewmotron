# Brewmotron Test Environment
# Upgraded to Python 3.11 for asyncio.timeout() support (Ubuntu 22.04, Python 3.11)

FROM ubuntu:22.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y \
    python3.11 \
    python3.11-dev \
    python3-pip \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Make Python 3.11 the default
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# Upgrade pip
RUN python3 -m pip install --upgrade pip setuptools wheel

# Create working directory
WORKDIR /brewmotron

# Copy requirements first for better caching
COPY requirements-test.txt /brewmotron/requirements-test.txt

# Install test dependencies
RUN pip3 install --no-cache-dir -r requirements-test.txt

# Copy source code
COPY . /brewmotron/

# Set Python path to include the project root
ENV PYTHONPATH=/brewmotron:$PYTHONPATH

# Default command runs the test suite
CMD ["python3", "run_tests.py", "unit"]
