# Brewmotron Manual Test Environment
# CraftBeerPi4 instance with Brewmotron plugins for manual testing

FROM ubuntu:22.04

# Build arguments for GitHub repository and branch
ARG GITHUB_REPO=https://github.com/MrLaister/brewmotron.git
ARG BRANCH_NAME=main

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV CBPI_CONFIG_FOLDER=/cbpi_config

# Install system dependencies
RUN apt-get update && apt-get install -y \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y \
    python3.11 \
    python3.11-dev \
    python3.11-venv \
    python3-pip \
    build-essential \
    git \
    pkg-config \
    libsystemd-dev \
    && rm -rf /var/lib/apt/lists/*

# Make Python 3.11 the default
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# Upgrade pip and install pipx
RUN python3 -m pip install --upgrade pip setuptools wheel pipx
RUN python3 -m pipx ensurepath

# Install CraftBeerPi4 using pipx
RUN pipx install cbpi4 --python python3.11

# Ensure pipx binaries are in PATH
ENV PATH="/root/.local/bin:${PATH}"

# Create working directory and config directory
WORKDIR /brewmotron
RUN mkdir -p ${CBPI_CONFIG_FOLDER}

# Clone plugin source code from GitHub
# Configure git to avoid credential helper issues
RUN GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=echo git config --global credential.helper "" && \
    git config --global --add safe.directory '*' && \
    git config --global url."https://".insteadOf git:// && \
    echo "Cloning from ${GITHUB_REPO} branch ${BRANCH_NAME}..." && \
    GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=echo git clone --depth 1 --branch ${BRANCH_NAME} ${GITHUB_REPO} /tmp/brewmotron-src && \
    mv /tmp/brewmotron-src/* /brewmotron/ && \
    rm -rf /tmp/brewmotron-src

# Set Python path to include the project root
ENV PYTHONPATH=/brewmotron:$PYTHONPATH

# Copy startup script
COPY docker/docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Expose CraftBeerPi4 web interface port
EXPOSE 8000

# Use startup script as entrypoint
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# Default command (can be overridden)
CMD ["cbpi", "start"]
